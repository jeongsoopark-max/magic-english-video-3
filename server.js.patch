+// Providers are tried in order; the first one that works wins:
+//
+//   (A) Cloudflare Realtime TURN (current): set TURN_KEY_ID + TURN_KEY_API_TOKEN.
+//       1,000 GB/month free, then $0.05/GB. The key is a long-lived master
+//       secret that never leaves the server; we mint short-lived credentials
+//       from it and cache them until shortly before they expire.
+//       Optional: TURN_TTL_SECONDS (default 14400 = 4h).
+//   (B) Metered ephemeral creds (legacy): set METERED_DOMAIN + METERED_API_KEY.
+//       Kept as a fallback; the free tier is only 500 MB/month as of 2026.
+//   (C) Static creds (coturn / any provider): set TURN_URLS (comma-separated),
 //       TURN_USERNAME, TURN_CREDENTIAL.
+//
+// If every provider fails we still return STUN, so most students connect
+// normally — only those behind restrictive NAT lose the relay path.
+
+const CF_TURN_KEY_ID = process.env.TURN_KEY_ID;
+const CF_TURN_API_TOKEN = process.env.TURN_KEY_API_TOKEN;
+const CF_TURN_TTL = Number(process.env.TURN_TTL_SECONDS || 14400);
+// Refresh 10 minutes before expiry so a running class never hits a dead credential.
+const CF_REFRESH_MARGIN_MS = 10 * 60 * 1000;
+
+let cfTurnCache = null;      // { iceServers, expiresAt }
+let cfTurnInflight = null;   // de-dupes bursts when a whole class joins at once
+
+async function getCloudflareIceServers() {
+  if (cfTurnCache && Date.now() < cfTurnCache.expiresAt) return cfTurnCache.iceServers;
+  if (cfTurnInflight) return cfTurnInflight;
+
+  const url = `https://rtc.live.cloudflare.com/v1/turn/keys/${CF_TURN_KEY_ID}/credentials/generate-ice-servers`;
+  const controller = new AbortController();
+  const timer = setTimeout(() => controller.abort(), 8000);
+
+  cfTurnInflight = (async () => {
+    try {
+      const r = await fetch(url, {
+        method: 'POST',
+        headers: {
+          Authorization: `Bearer ${CF_TURN_API_TOKEN}`,
+          'Content-Type': 'application/json',
+        },
+        body: JSON.stringify({ ttl: CF_TURN_TTL, customIdentifier: 'magic-english' }),
+        signal: controller.signal,
+      });
+      if (!r.ok) {
+        const body = await r.text().catch(() => '');
+        throw new Error(`HTTP ${r.status} ${body.slice(0, 160)}`);
+      }
+      const data = await r.json();
+      if (!data || !Array.isArray(data.iceServers) || !data.iceServers.length) {
+        throw new Error('response had no iceServers');
+      }
+      cfTurnCache = {
+        iceServers: data.iceServers,
+        expiresAt: Date.now() + CF_TURN_TTL * 1000 - CF_REFRESH_MARGIN_MS,
+      };
+      console.log('[turn] Cloudflare credentials issued (ttl %ds)', CF_TURN_TTL);
+      return cfTurnCache.iceServers;
+    } finally {
+      clearTimeout(timer);
+      cfTurnInflight = null;
+    }
+  })();
+
+  return cfTurnInflight;
+}
